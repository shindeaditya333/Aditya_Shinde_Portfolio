{
  "name": "recruitment-management-system",
  "version": "1.0.0",
  "description": "RecruitFlow - AI-Powered Recruitment Management System",
  "scripts": {
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
